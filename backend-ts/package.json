{
  "name": "aistudi-web-api-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "smoke:native-browser": "tsx scripts/native-browser-smoke.ts",
    "smoke:native-generate": "tsx scripts/native-generate-smoke.ts",
    "smoke:native-mixed-tools": "tsx scripts/native-mixed-tools-smoke.ts",
    "smoke:native-protocol": "tsc -p tsconfig.smoke.json && node dist-smoke/scripts/native-protocol-smoke.js",
    "capture:function-tool": "tsx scripts/capture-function-tool.ts",
    "test": "tsx --import ./tests/setup-runtime.ts --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "cloakbrowser": "^0.5.9",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "playwright-core": "^1.62.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2"
  }
}
