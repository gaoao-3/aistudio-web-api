# aistudio-api 配置
# 复制此文件为 .env 并修改

# ========== 服务 ==========
AISTUDIO_PORT=3006
AISTUDIO_HOST=0.0.0.0
# 运行数据默认使用当前项目的 data/；如需外置数据目录可显式指定
# AISTUDIO_RUNTIME_ROOT=D:\path\to\aistudio-api-ts

# ========== 浏览器 ==========
# 浏览器是否无头模式（1=无头，0=有头）
AISTUDIO_BROWSER_HEADLESS=1
# 浏览器连续空闲多久后自动关闭（毫秒）；0 表示禁用，默认 30 分钟
AISTUDIO_BROWSER_IDLE_TIMEOUT_MS=1800000
# 页面请求超时（毫秒）
AISTUDIO_BROWSER_TIMEOUT_MS=120000
# API 请求体上限（字节，默认 32 MiB）
AISTUDIO_API_BODY_LIMIT_BYTES=33554432
# 浏览器使用的代理（如 Clash）；Docker 容器内应填宿主机局域网 IP，而非 127.0.0.1
# AISTUDIO_PROXY_URL=http://127.0.0.1:7890
# 登录流程最长等待时间（毫秒）
AISTUDIO_LOGIN_TIMEOUT_MS=600000
# 已结束登录会话保留时间，供前端读取结果（毫秒）
AISTUDIO_LOGIN_SESSION_RETENTION_MS=600000

# ========== 网络 / 认证 ==========
# CloakBrowser 代理地址；留空时读取 HTTPS_PROXY / HTTP_PROXY
AISTUDIO_PROXY_URL=
# API 鉴权，支持单个 key 或逗号分隔多个 key
AISTUDIO_API_KEY=
# AISTUDIO_API_KEYS=key-1,key-2
# 网页创建的 API 密钥存储文件（留空则使用 data/apikeys.json）
# AISTUDIO_APIKEYS_FILE=/path/to/data/apikeys.json
# 认证文件路径（可选，留空自动搜索 data/ 目录）
AISTUDIO_AUTH_FILE=
# ========== 状态文件 ==========
# 账号存储目录（留空则使用默认 data/accounts）
AISTUDIO_ACCOUNTS_DIR=
# 用量统计文件路径（留空则使用默认 data/stats.json）
AISTUDIO_STATS_FILE=

# AI Studio 私有 GenerateContent 续接（实验性、默认关闭；只对同一账号的函数调用链启用）
AISTUDIO_PRIVATE_CONTINUATION=0

# ========== 精确响应缓存 ==========
# 仅缓存请求完全相同且不含工具调用的响应；默认持久化在 data/response-cache.sqlite
AISTUDIO_RESPONSE_CACHE_ENABLED=1
# 缓存有效期（秒），0 表示禁用
AISTUDIO_RESPONSE_CACHE_TTL_SECONDS=3600
# 缓存总大小上限（字节，默认 32 MiB）
AISTUDIO_RESPONSE_CACHE_MAX_BYTES=33554432
# 单个请求或响应的缓存上限（字节，默认 1 MiB）
AISTUDIO_RESPONSE_CACHE_MAX_ENTRY_BYTES=1048576

# 模型默认参数 YAML（留空则使用运行目录的 config.yaml）
# AISTUDIO_MODEL_DEFAULTS_FILE=/path/to/config.yaml
